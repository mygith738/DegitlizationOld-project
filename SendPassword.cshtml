@using Digitalization.Models

@model List<SendPasswordModel>

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

<div class="mt-5">
    <div class="mx-5 mt-5">
        <br><br>
        <div class="main m-5 p-5">
            @{
                int i = 1;
            }
            @foreach(var employee in @Model)
            {
                <div class="row mt-3">
                    <div class="col-1">
                        @if(i==1)
                        {
                            <label class="form-label">Serial Number</label>
                        }
                        <input type="text" class="form-control" asp-for="@i" readonly/>
                    </div>
                    <div class="col-2">
                        @if(i==1)
                        {
                            <label class="form-label">StaffNumber</label>
                        }
                        <input type="text" class="form-control" asp-for="@employee.StaffNumber" readonly/>
                    </div>
                    <div class="col-3">
                        @if(i==1)
                        {
                            <label class="form-label">Name</label>
                        }
                        <input type="text" class="form-control" asp-for="@employee.Name" readonly/>
                    </div>
                    <div class="col-3">
                        @if(i==1)
                        {
                            <label class="form-label">Email</label>
                        }
                        <input type="text" class="form-control" asp-for="@employee.Email" readonly/>
                    </div>
                    <div class="col-3">
                        @if(i==1)
                        {
                            <label class="form-label">Status</label>
                        }
                        <input type="text" class="form-control" asp-for="@employee.Status" readonly/>
                    </div>
                </div>
                i++;
            }
        </div>
    </div>
</div>