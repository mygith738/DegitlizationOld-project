@using Digitalization.Models.UserModel
@model ResetPasswordModel
<!-- css -->
<link rel="stylesheet" href="~/assets/css/user/common-with-hover.css">

<main>

    <div class="container my-2">
        <br><br><br><br><br><br>
        <div class="row mt-5">
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
            <div class="main col-lg-6 col-md-8 col-sm-6 m-1">
                @*<button onclick="window.print();" class="btn btn-primary float-right mt-3">
                    <svg width="16" height="16" fill="currentColor" class="bi bi-printer-fill" viewBox="0 0 16 16">
                        <path d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2H5zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1z" />
                        <path d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2V7zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                    </svg>
                </button>*@
                <div class="m-4 pt-3 text-center">
                    <h2 class="">Reset Password</h2>
                    <h4 id="ErrorMessage" class="text-danger">@ViewBag.ExceptionError</h4>
                </div>
                <form asp-action="ResetPassword" class="m-4 pb-5" onsubmit="return validateForm()" name="reset-form">
                    <div class="mb-3">
                        @*this field is just to pass StaffNumber to model and hidden*@
                        @*value to this field is passed from Controller*@
                        <input type="text" asp-for="StaffNumber" value="@ViewBag.StaffNumber" hidden>

                        <label for="SystemPassword" class="form-label">Password recieved through E-Mail</label>
                        <input type="password" asp-for="SystemPassword" class="form-control" id="SystemPassword" placeholder="Enter Old Password here.." onclick="clearsystempasswordvalidation()" onkeypress="clearsystempasswordvalidation()" autofocus>
                        <span id="validatesystempassword" class="text-danger">@ViewBag.ErrorMessage</span>
                    </div>
                    <div class="mb-3">
                        <label for="NewPassword" class="form-label">New Password</label>
                        <input type="password" asp-for="NewPassword" class="form-control" id="NewPassword" placeholder="Enter New Password here.." onclick="clearnewpasswordvalidation()" onkeypress="clearnewpasswordvalidation()">
                        <span id="validatenewpassword" class="text-danger">@ViewBag.NewPasswordError</span>
                    </div>
                    <div class="mb-3">
                        <label for="ConfirmPassword" class="form-label">ConfirmPassword</label>
                        <input type="password" asp-for="ConfirmPassword" class="form-control" id="ConfirmPassword" placeholder="Please Confirm Your Password.." onclick="clearconfirmpasswordvalidation()" onkeypress="clearconfirmpasswordvalidation()">
                        <span id="validateconfirmpassword" class="text-danger">@ViewBag.ConfirmPasswordError</span>
                    </div>
                    <div class="row mb-3 mx-2">
                        <div class="form-check col">
                            <input type="checkbox" class="form-check-input" id="showPassword" onclick="togglePassword()">
                            <label class="form-check-label" for="showPassword">Show Password</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="text-left col">
                            <a class="btn btn-primary px-5 mt-2 home-btn" href="@Url.Action("Logout","User")">Home</a>                            
                        </div>
                        <div class="text-right col">
                            <button type="submit" class="btn btn-primary px-5 mt-2 submit-btn">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
        </div>
    </div>
</main>



<script src="~/assets/js/user/reset-password.js"></script>