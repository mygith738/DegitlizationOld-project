@using Digitalization.Models.UserModel
@model List<LeaveModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">User</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("Leave","User")" style="text-decoration: none">Leave</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("MyLeaveRequest","User")" style="text-decoration: none">MyLeaveRequest</a></li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">My Leave Requests</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">

                                </div>
                            </div>
                            <hr>
                            @if (!ViewBag.Search)
                            {
                                <form asp-action="MyLeaveRequest" onsubmit="return validateForm()" method="post" name="request-page">
                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                        <div class="col-3 mb-3">
                                            <label for="Year" class="form-label">Year</label>
                                            <select class="form-control" id="Year" name="Year" onchange="clearyearvalidation()" onclick="clearyearvalidation()">
                                                <option value="Null">Please select Year</option>
                                            </select>
                                            <span id="validateyear" class="text-danger"></span>
                                        </div>
                                        <div class="col-3 mb-3">
                                            <label for="Month" class="form-label">Month</label>
                                            <select class="form-control" id="Month" name="Month" onchange="clearmonthvalidation()" onclick="clearmonthvalidation()">
                                                <option value="Null">Please select Month</option>
                                                <option value="0">All</option>
                                                <option value="1">January</option>
                                                <option value="2">February</option>
                                                <option value="3">March</option>
                                                <option value="4">April</option>
                                                <option value="5">May</option>
                                                <option value="6">June</option>
                                                <option value="7">July</option>
                                                <option value="8">August</option>
                                                <option value="9">September</option>
                                                <option value="10">October</option>
                                                <option value="11">November</option>
                                                <option value="12">December</option>
                                            </select>
                                            <span id="validatemonth" class="text-danger"></span>
                                        </div>
                                        <div class="col-3 mb-3">
                                            <label for="Status" class="form-label">Status</label>
                                            <select class="form-control" id="Status" name="Status" onchange="clearstatusvalidation()" onclick="clearstatusvalidation()">
                                                <option value="null">Please select Status</option>
                                                <option value="Null">All</option>
                                                <option value="APPLIED">APPLIED</option>
                                                <option value="FORWARDED">FORWARDED</option>
                                                <option value="APPROVED">APPROVED</option>
                                                <option value="SANCTIONED">SANCTIONED</option>
                                                <option value="CANCELLED">CANCELLED</option>
                                            </select>
                                            <span id="validatestatus" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="m-2">
                                        <button type="submit" class="btn btn-primary px-5">Search</button>
                                    </div>
                                </form>
                            }
                            else if (ViewBag.Search)
                            {
                                <div class="tab-content">
                                    <div class="" id="userdetails">
                                        <table class="table table-bordered text-center" id="DataTable">
                                            <thead class="p-3">
                                                <tr>
                                                    <th scope="col">Sl. No.</th>
                                                    <th scope="col">Leave ID</th>
                                                    <th scope="col">Name</th>
                                                    <th scope="col">Leave Type</th>
                                                    <th scope="col">Leave From</th>
                                                    <th scope="col">Leave To</th>
                                                    <th scope="col">Status</th>
                                                    <th scope="col">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Count() > 0)
                                                {
                                                    @foreach (var leave in Model)
                                                    {
                                                        <tr>
                                                            <td> @( ((Int32) 1) + @Model.IndexOf(leave) ) </td>
                                                            <td scope="row">@leave.LeaveID</td>
                                                            <td>@leave.StaffFirstName</td>
                                                            @if(@leave.TypeOfLeave == "EL")
                                                            {
                                                                <td>Earned Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "CL")
                                                            {
                                                                <td>Casual Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "HL")
                                                            {
                                                                <td>Half Pay Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "RH")
                                                            {
                                                                <td>Restricted Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "ML")
                                                            {
                                                                <td>Maternity Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "SL")
                                                            {
                                                                <td>Special Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "LWP")
                                                            {
                                                                <td>Leave without Pay</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "EOL")
                                                            {
                                                                <td>Extraordinary Leave</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "OOD")
                                                            {
                                                                <td>Official Office Duty</td>
                                                            }
                                                            else if(@leave.TypeOfLeave == "CO")
                                                            {
                                                                <td>Compensatory Off</td>
                                                            }
                                                            <td>@leave.LeaveFrom</td>
                                                            <td>@leave.LeaveTo</td>
                                                            <td>

                                                                <a class="btn btn-info text-white">@leave.OldStatus</a>

                                                                @*@if (@leave.OldIndentStatus == "APPROVED" ||
                                                               @leave.OldIndentStatus == "COMPLETED" || @leave.OldIndentStatus == "ACCEPTED" ||
                                                               @leave.OldIndentStatus == "CLARIFIED" || @leave.OldIndentStatus == "FORWARDED")
                                                                {
                                                                    <a class="btn btn-success text-light">@leave.OldIndentStatus</a>
                                                                }
                                                                else if (@leave.OldIndentStatus == "CANCELLED" || @leave.OldIndentStatus == "REJECTED")
                                                                {
                                                                    <a class="btn btn-danger text-light">@leave.OldIndentStatus</a>
                                                                }
                                                                else if (@leave.OldIndentStatus == "RAISED" || 
                                                                    @leave.OldIndentStatus == "NEED CLARIFICATION" || @leave.OldIndentStatus == "HOLD" || 
                                                                    @leave.OldIndentStatus == "IN PROGRESS" || @leave.OldIndentStatus == "REOPEN")
                                                                {
                                                                    <a class="btn btn-warning">@leave.OldIndentStatus</a>
                                                                }
                                                                else if (@leave.OldIndentStatus == "ASSIGNED")
                                                                {
                                                                    <a class="btn btn-primary text-light">@leave.OldIndentStatus</a>
                                                                }
                                                                else
                                                                {
                                                                    <a class="btn btn-secondary text-light">@leave.OldIndentStatus</a>
                                                                }*@
                                                            </td>
                                                            <td>
                                                                <a href="@Url.Action("ViewMyLeaveRequest","User",new { LeaveID = leave.LeaveID})" class="btn btn-primary">View</a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/assets/js/user/my-leave-request.js"></script>