@using Microsoft.AspNetCore.Http;

@using Digitalization.Models.UserModel
@model List<AttendanceModel>

@inject IHttpContextAccessor HttpContextAccessor

<!-- css -->
<link rel="stylesheet" href="~/assets/css/user/home-page.css">

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- Second design -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main py-4 pb-0">
                    <div class="row ms-5 mb-4">
                        @if (@HttpContextAccessor.HttpContext.Session.GetString("Role") != null &&
                            @HttpContextAccessor.HttpContext.Session.GetString("Role") != "" &&
                            @HttpContextAccessor.HttpContext.Session.GetString("Role") == "Admin")
                        {
                            <div class="row ms-1">
                                <div class="mb-4 border mr-4">
                                    <h5 class="text-center mt-3 text-info">If there are any particular operations need to be performed by admin will be displayed here.</h5>
                                    <div class="px-2 py-3">
                                        @*@if(@ViewBag.BeginningMonth == "Yes")*@
                                        @if(true)
                                        {
                                           @*<a class="btn btn-primary mr-4 px-4 py-2" href="@Url.Action("DriversShiftAssign","Admin")">Driver Shift Assign</a>
                                           <a class="btn btn-primary mr-4 px-4 py-2" href="@Url.Action("SecurityShiftAssign","Admin")">Security Shift Assign</a>*@
                                           <a class="btn btn-primary mr-4 px-4 py-2" href="@Url.Action("AddHolidays","Admin")">Add Holidays</a>
                                        }
                                        @*<a class="btn btn-primary mr-4 px-4 py-2" href="@Url.Action("ViewInchargeData","Admin")">Incharge Data</a>*@
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="my-2">
                            <a class="btn btn-primary float-right mt-3" href="@Url.Action("Home","User")">Refresh</a>
                        </div>
                        <div class="text-center py-3">
                            <marquee direction = "left" width="50%"><h5 class="text-danger text-center">@ViewBag.WarningIndent</h5></marquee>
                            <marquee direction = "left" width="50%"><h5 class="text-danger text-center">@ViewBag.WarningLeave</h5></marquee>
                            <marquee direction = "left" width="50%"><h5 class="text-danger text-center">@ViewBag.WarningPermission</h5></marquee>
                        </div>
                        <div class="row ms-3">
                            <div class="row mb-4 border p-3 col-6 mr-4">
                                <h3 class="ms-2 text-center">Inbox</h3> 
                                <div class="idrindentdiv pt-3">                                           
                                    <table class="table table-hover border text-black px-2">
                                        <tr onclick="redirectinboxindent()">
                                            <td>
                                                <a href="@Url.Action("PendingRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Inter Departmental Requisition</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("PendingRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.PendingIDRIndentRequests</a>
                                            </td>
                                        </tr> 
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("PendingMaterialGatePassRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Material Gate Pass</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("PendingMaterialGatePassRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.PendingMaterialGatePassRequests</a>
                                            </td>
                                        </tr>  
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("PendingVisitorPassRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Visitor Pass</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("PendingVisitorPassRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.PendingVisitorPassRequests</a>
                                            </td>
                                        </tr> 
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("PendingVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Vehicle Indent</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("PendingVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.PendingVehicleIndentRequests</a>
                                            </td>
                                        </tr> 
                                        @*<tr>
                                            <td>
                                                <a href="@Url.Action("PendingPermissionRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Permission Requests</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("PendingPermissionRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.PendingPermissionRequests</a>
                                            </td>
                                        </tr> *@
                                    </table>
                                </div>                                                                                                                   
                            </div>

                            <div class="row mb-4 border p-3 col-6">
                                <h3 class="ms-2 text-center">Outbox</h3> 
                                <div class="idrindentdiv pt-3">                                           
                                    <table class="table table-hover border text-black px-2">
                                        <tr onclick="redirectoutboxindent()">
                                            <td>
                                                <a href="@Url.Action("OutboxIDRRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">Inter Departmental Requisition</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("OutboxIDRRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.MyIDRIndentRequests</a>
                                            </td>
                                        </tr> 
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("OutboxMGPRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">Material Gate Pass</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("OutboxMGPRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.OutboxMGPRequests</a>
                                            </td>
                                        </tr> 
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("OutboxVisitorPassRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">Visitor Pass</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("OutboxVisitorPassRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.OutboxVisitorPassRequests</a>
                                            </td>
                                        </tr> 
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("OutBoxVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">Vehicle Indent</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("OutBoxVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.OutboxVehicleIndentRequests</a>
                                            </td>
                                        </tr> 
                                        @* <tr>
                                            <td>
                                                <a href="@Url.Action("OutboxPermissionRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">Permission Request</a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("OutboxPermissionRequestsWithoutFilter","User")" style="text-decoration: none" class="text-black">@ViewBag.OutboxPermissionRequests</a>
                                            </td>
                                        </tr> *@
                                    </table>
                                </div>                                                                                                           
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>

<script>
        $(document).ready(function () {
            setInterval(function () {
                $("#datetime").load(window.location.href + " #datetime");
            }, 300);
        });

        $(window).on('load', function () { // makes sure the whole site is loaded
            $('#status').fadeOut(); // will first fade out the loading animation
            $('#preloader').delay(350).fadeOut('slow'); // will fade out the white DIV that covers the website.
            $('body').delay(350).css({ 'overflow': 'visible' });
        })
    </script>

<script src="~/assets/js/user/home.js"></script>