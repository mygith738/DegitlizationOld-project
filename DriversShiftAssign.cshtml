@using Digitalization.Models.CommonModel
@model List<DriversModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->


<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">DriverShiftAssign</li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                    <!-- @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@ -->
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Driver Shift Assign</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2">
                                    <a class="btn btn-primary" href="@Url.Action("PrintDriversShiftDetails","Admin")">Print Driver Shift</a>
                                </div>
                                <div class="col-2">
                                    <a class="btn btn-primary" href="@Url.Action("DriversShift","Admin")">Edit Shift Details</a>
                                </div>
                            </div>
                            <hr>

                            <span id="DriverCount" style="display: none">@Model.Count()</span>

                            <div>
                                <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="DriversShiftAssign" class="m-4 pb-5" name="register-form">
                                    <div class="tab-content">
                                        <div class="DriverTab" id="drivers">
                                            <div class="row m-1 rounded-top mt-4 p-3">
                                                <table class="table-bordered text-center">
                                                    <tr class="py-3">
                                                        <th class="text-primary">Type of Shift</th>
                                                        <th class="text-primary">Short Form</th>
                                                        <th class="text-primary">Working hours</th>
                                                        <th class="text-primary">Lunch hours</th>
                                                    </tr>
                                                    @for (var row = 0; row < Model.Count(); row++)
                                                    {
                                                        foreach(var drivershift in Model[row].DriversShift)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @if(@drivershift.ShiftType == "SH1")
                                                                    {
                                                                        <p>Shift 1</p>
                                                                    }
                                                                    else if(@drivershift.ShiftType == "GSH")
                                                                    {
                                                                        <p>General Shift</p>
                                                                    }
                                                                    else if(@drivershift.ShiftType == "SH2")
                                                                    {
                                                                        <p>Shift 2</p>
                                                                    }
                                                                </td>
                                                                <td>@drivershift.ShiftType</td>
                                                                <td>@drivershift.WorkingHours</td>
                                                                <td>@drivershift.LunchHours</td>
                                                            </tr>
                                                        }
                                                        break;
                                                    }
                                                </table>
                                            </div>
                                            <div class="border rounded-top p-3 mx-3">
                                                <table class="table table-bordered text-center" id="DataTable">
                                                    <thead class="p-3">
                                                        <tr>
                                                            <th scope="col" class="text-primary">Staff Number</th>
                                                            <th scope="col" class="text-primary">Name</th>
                                                            <th scope="col" class="text-primary">Assigned Shift</th>
                                                            <th scope="col" class="text-primary">From Date</th>
                                                            <th scope="col" class="text-primary">To Date</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.Count() > 0)
                                                        {
                                                            @for (var row = 0; row < Model.Count(); row++)
                                                            {
                                                                <div style="display: none" class="row">
                                                                    <div class="col-3">
                                                                        <input type="text" id="StaffNumber(@row)" asp-for="@Model[row].StaffNumber"/>
                                                                    </div>
                                                                    <div class="col-3">
                                                                        <input type="text" id="Designation(@row)" asp-for="@Model[row].Designation"/>
                                                                    </div>
                                                                    <div class="col-3">
                                                                        <input type="text" id="AssignedDriverShift(@row)" asp-for="@Model[row].AssignedShift"/>
                                                                    </div>
                                                                    <div class="col-3">
                                                                        <input type="text" id="AlternateDriverShiftFromDate(@row)" asp-for="@Model[row].FromDate"/>
                                                                    </div>
                                                                    <div class="col-3">
                                                                        <input type="text" id="AlternateDriverShiftToDate(@row)" asp-for="@Model[row].ToDate"/>
                                                                    </div>
                                                                </div>
                                                                <tr>
                                                                    <td scope="row">@Model[row].StaffNumber</td>
                                                                    <td>@Model[row].Name</td>
                                                                    <td id="DriverShiftTD(@row)">
                                                                        <input class="form-check-input" type="radio" name="DriverShift(@row)" id="DriverShift(@row)" onclick="assignDriverShift('SH1',@row)">
                                                                        <label class="form-check-label" for="inlineRadio1">SH1</label>
                                                                        <br>
                                                                        <input class="form-check-input" type="radio" name="DriverShift(@row)" id="DriverShift(@row)" onclick="assignDriverShift('GSH',@row)">
                                                                        <label class="form-check-label" for="inlineRadio2">GSH</label>
                                                                        <br>
                                                                        <input class="form-check-input" type="radio" name="DriverShift(@row)" id="DriverShift(@row)" onclick="assignDriverShift('SH2',@row)">
                                                                        <label class="form-check-label" for="inlineRadio1">SH2</label>
                                                                        <br>
                                                                        <span id="validatedrivershift(@row)" class="text-danger"></span>
                                                                    </td>
                                                                    <td>
                                                                        <input type="date" class="form-control" id="DriverShiftFromDate(@row)" onclick="cleardrivershiftfromdatevalidation(@row)" onchange="cleardrivershiftfromdatevalidation(@row)"/>
                                                                        <span id="validatedriverfromdate(@row)" class="text-danger"></span>
                                                                    </td>
                                                                    <td>
                                                                        <input type="date" class="form-control" id="DriverShiftToDate(@row)" onclick="cleardrivershifttodatevalidation(@row)" onchange="cleardrivershifttodatevalidation(@row)"/>
                                                                        <span id="validatedrivertodate(@row)" class="text-danger"></span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>

                                                <button type="submit" class="btn btn-primary px-5 mt-2 float-end" onclick="return validateForm()">Submit</button>
                                                <a class="btn btn-primary px-5 mt-2 ml-4" href="@Url.Action("Home","User")">Go Back</a>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/admin/drivers-shift-assign.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>