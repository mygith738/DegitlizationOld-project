@using Digitalization.Models

@model List<HolidaysModel>

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->


<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5">
                <br><br>
                <div class="main m-5 p-5">
                    <nav aria-label="breadcrumb" class="pl-3">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("Home","User")" style="text-decoration: none">User</a></li>
                            <li class="breadcrumb-item"><a href="@Url.Action("Holidays","User")" style="text-decoration: none">Holidays</a></li>
                        </ol>
                    </nav>
                    @if(ViewBag.TypeOfHoliday == "CH")
                    {
                        <h3 class="text-center">Closed Holidays</h3>
                    }
                    else if(ViewBag.TypeOfHoliday == "RH")
                    {
                        <h3 class="text-center">Restricted Holidays</h3>
                    }
                    else
                    {
                        <h3 class="text-center">Holidays</h3>
                    }

                    @{
                        int i = 1;
                    }
                    
                    @if(ViewBag.IsFiltered == false)
                    {
                        <form asp-action="Holidays" onsubmit="return validateForm()" method="post" name="request-page">
                            <div class="row m-1 border rounded-top mt-4 p-3">
                                <div class="col-3 mb-3">
                                    <label for="Year" class="form-label">Year</label>
                                    <select class="form-control" id="Year" name="Year" onchange="clearyearvalidation()" onclick="clearyearvalidation()">
                                        <option value="Null">Please select Year</option>
                                        <option value="2022">2022</option>
                                        <option value="2023">2023</option>
                                        <option value="2024">2024</option>
                                        <option value="2025">2025</option>
                                    </select>
                                    <span id="validateyear" class="text-danger"></span>
                                </div>
                                <div class="col-3 mb-3">
                                    <label for="Type" class="form-label">Type of holiday</label>
                                    <select class="form-control" id="Type" name="Type" onchange="cleartypevalidation()" onclick="cleartypevalidation()">
                                        <option value="Null">Please select any one</option>
                                        <option value="CH">Closed Holidays</option>
                                        <option value="RH">Restricted Holidays</option>
                                    </select>
                                    <span id="validatetype" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="m-2">
                                <button type="submit" class="btn btn-primary px-5">Search</button>
                            </div>
                        </form>
                    }
                    else if(ViewBag.IsFiltered == true)
                    {
                        @*<a class="btn btn-primary mb-3 text-white" href="@Url.Action("ApplyLeave","User")">Apply Leave</a>*@
                        <table class="table table-bordered text-center" id="DataTable">
                            <thead class="p-3">
                                <tr>
                                    <th scope="col" class="text-primary">Sl. No.</th>
                                    <th scope="col" class="text-primary">Date</th>
                                    <th scope="col" class="text-primary">Day</th>
                                    <th scope="col" class="text-primary">Occasion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var holiday in @Model)
                                {
                                    <tr>
                                        <td> @( ((Int32) 1) + @Model.IndexOf(holiday) ) </td>
                                        <td>@holiday.Date</td>
                                        <td>@holiday.Day</td>
                                        <td>@holiday.Occassion</td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/assets/js/user/holidays.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });

    $('#DataTable').dataTable( {
        "pageLength": 100
      } );
</script>