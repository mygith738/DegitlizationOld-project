@using Microsoft.AspNetCore.Http;

@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1220" />
    <meta name="robots" content="noindex" />
    <title>e-bandhu</title>

    <!-- icon logo in title bar -->
    <link rel="icon" href="~/assets/images/CMTI Logo.png" type="image/x-icon">

    <!-- bootstrap -->
    <link href="~/assets/bootstrap-5.1.3/css/bootstrap.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

    <!-- css -->
    <link rel="stylesheet" href="~/assets/css/layout/layoutwithoutnav-page.css">

    <!-- jquery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

</head>
<body onload="init()">
    <!-- header start -->
    <header class="">
        <div class="row">
            <div class="col-sm-4 col-xs-4 col-md-3 col-lg-3 col-4">
                <div id="datetime" style="display: none">
                    @*<p id="time" hidden>@DateTime.Now.ToString("hh-mm-ss tt")</p>
                    <p id="date" hidden>@DateTime.Now.ToString("dd/MM/yyyy")</p>*@
                </div>
                <a href="~/User/Index"><img src="~/assets/images/CMTI Logo.png" alt="CMTI LOGO" class="rounded float-start ml-4 cmti-logo"></a>
            </div>
            <div class="col-sm-4 col-xs-4 col-md-6 col-lg-6 col-4 text-center fs-6">
                <a href="~/User/Index"><img src="~/assets/images/e-bandhu-logo.png" alt="ebandhu" class="e-bandhu-logo"></a>
            </div>
            <div class="col-sm-4 col-xs-4 col-md-3 col-lg-3 col-4 pt-3 ps-3 row" style="text-align: right;">
                
                <div class="col-12 row">
                    <div class="col-6" id="datetimediv">
                       <div id="logindiv" style="display: none" class="px-3 mt-2"> 
                            <a href="@Url.Action("Login","User")" class="btn btn-primary px-4 py-2">
                                <span>Login
                                    <svg width="16" height="16" fill="currentColor" class="bi bi-box-arrow-in-right" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0v-2z" />
                                        <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
                                    </svg>
                                </span>
                            </a>
                       </div>
                       <div class="mt-3">
                           <h5 id="FooterID"></h5>
                       </div>
                    </div>
                    <div class="dropdown col-3 mt-2" id="userguidediv"> 
                        <button class="btn btn-info dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-book" viewBox="0 0 16 16">
                                <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z" />
                            </svg>
                        </button>
                        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                            <a class="dropdown-item" target="_blank" href="../Files/User Manual.pdf">
                                User Manual
                            </a>
                            @*<a class="dropdown-item" target="_blank" href="../Files/Inter Departmental Requisition.pdf">
                                IDR Indent
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/Leave.pdf">
                                Leave
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/MaterialGatePass.pdf">
                                Material Gate Pass
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/PermissionSlip.pdf">
                                Permission Slip
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/PurchaseIndentUpto25k.pdf">
                                Purchase Indent Upto 25k
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/VehicleIndent.pdf">
                                Vehicle Indent
                            </a>
                            <a class="dropdown-item" target="_blank" href="../Files/VisitorPass.pdf">
                                Visitor Pass
                            </a>*@
                        </div>
                    </div>
                    @if (@HttpContextAccessor.HttpContext.Session.GetString("ShortName") != null ||
                  @HttpContextAccessor.HttpContext.Session.GetString("ShortName") != "")
                    {
                        <div class="dropdown col-2 mt-2" id="profiledropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                @HttpContextAccessor.HttpContext.Session.GetString("ShortName")
                            </button>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item">
                                    @HttpContextAccessor.HttpContext.Session.GetString("Name")
                                </a>
                                <a class="dropdown-item" href="@Url.Action("Logout","User")">
                                    Sign Out
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown col-2 mt-2" id="profiledropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class='bx bxs-user nav_icon'></i>
                            </button>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" onclick="window.print();">
                                    Print
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <hr class="header-devider" />
    </header>
    <!-- header end -->
    <div class="mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- footer start-->
    <footer>
        <div class="footer py-0 ms-1 fs-5 row" id="footer">
            <div class="text-center">
                <p style="margin: 0px">
                    &copy;
                    CMTI All rights reserved. 
                    @*<span id="">
                        Please contact
                        <b><a style="text-decoration: none" class="text-black-50" href="mailto: cmti.digitalization@gmail.com">cmti.digitalization@gmail.com</a> </b>
                        for any issues.
                    </span><br />*@
                    @*<span id="FooterID"></span>*@
                </p>
            </div>
        </div>
    </footer>
    <!-- footer end-->
    <script src="~/assets/js/layout/layout-without-nav.js"></script>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

    @*<script>
        $(document).ready(function () {
            setInterval(function () {
                $("#datetime").load(window.location.href + " #datetime");
            }, 300);
        });

    </script>*@
</body>
</html>
