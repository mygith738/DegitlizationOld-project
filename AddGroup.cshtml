@using Digitalization.Models.AdminModel
@model GroupModel

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <nav aria-label="breadcrumb" class="pl-3">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("ViewGroups","Admin")" style="text-decoration: none">ViewGroups</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Add Group</li>
                            </ol>
                        </nav>
                        <h2 class="text-center">Add Group</h2>
                        <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                        <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                        <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                        <hr>
                        <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="AddGroup" class="m-4 pb-5" name="register-form">
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <div class="row">
                                        <div class="row m-1 border rounded-top mt-4 p-3">
                                            <div class="row">
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="GroupName" class="form-label">Group Name</label>
                                                    <input type="text" asp-for="GroupName" class="form-control" id="GroupName" onkeypress="cleargroupnamevalidation()" onclick="cleargroupnamevalidation()" autofocus>
                                                    <span id="validategroupname" class="text-danger"></span>
                                                </div>
                                                <div class="col-3 mb-3 row">
                                                    <label for="CentreId" class="form-label">Center Name</label>
                                                    @if (Model.Centers.Count() > 0)
                                                    {
                                                        <select asp-for="CenterID" asp-items="@(new SelectList(Model.Centers,"CenterId","CenterName"))" class="form-control" id="CenterId" onchange="clearcentervalidation()" onclick="clearcentervalidation()">
                                                            <option value="Null">Please Select Your Center</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <select asp-for="CenterID" class="form-control" id="CenterId">
                                                            <option value="Null">Please Select Your Center</option>
                                                        </select>
                                                    }
                                                    <span id="validatecenter" class="text-danger">@ViewBag.CenterNameError</span>
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="GHStaffNumber" class="form-label">Group Head StaffNumber</label>
                                                    <input type="number" onwheel="this.blur()" asp-for="GHStaffNumber" class="form-control" id="GHStaffNumber" onkeypress="clearghstaffnumbervalidation()" onclick="clearghstaffnumbervalidation()">
                                                    <span id="validateghstaffnumber" class="text-danger">@ViewBag.GHStaffNumberError</span>
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="SGHStaffNumber" class="form-label">Secondary Group Head StaffNumber</label>
                                                    <input type="number" onwheel="this.blur()" asp-for="SGHStaffNumber" id="SGHStaffNumber" class="form-control" onkeypress="clearsghstaffnumbervalidation()" onclick="clearsghstaffnumbervalidation()">
                                                    <span id="validatesghstaffnumber" class="text-danger">@ViewBag.SGHStaffNumberError</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary px-5 mt-2" onclick="return validateForm()">Submit</button>
                                    <a class="btn btn-primary float-end px-5 mt-2 ml-4" href="@Url.Action("ViewGroups","Admin")">Go Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/admin/add-group.js"></script>