@using Digitalization.Models.AdminModel
@model List<CenterModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->


<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">ViewCenters</li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                    <!-- @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@ -->
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">View Centers</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">

                                </div>
                            </div>
                            <hr>
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <a href="@Url.Action("AddCenter","Admin")" class="btn btn-primary mb-3">Add Center</a>
                                    <table class="table table-bordered text-center" id="DataTable">
                                        <thead class="p-3">
                                            <tr>
                                                <th scope="col">Sl. No.</th>
                                                <th scope="col">Center Name</th>
                                                <th scope="col">Center Head StaffNumber</th>
                                                <th scope="col">Center Head Name</th>
                                                <th scope="col">Backup StaffNumber</th>
                                                <th scope="col">Backup Name</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Count() > 0)
                                            {
                                                @foreach (var center in Model)
                                                {
                                                    <tr>
                                                        <td> @( ((Int32) 1) + @Model.IndexOf(center) ) </td>
                                                        <td>@center.CenterName</td>
                                                        <td>@center.CHStaffNumber</td>
                                                        <td>@center.CenterHeadName</td>
                                                        <td>@center.CHBackupStaffNumber</td>
                                                        <td>@center.CHBackupName</td>
                                                        <td>
                                                            <a href="@Url.Action("EditCenter","Admin",new { CenterID = center.CenterId})" class="btn btn-primary mb-2">Edit</a>
                                                            <a href="@Url.Action("DeleteCenter","Admin",new { CenterID = center.CenterId})" class="btn btn-primary mb-2">Delete</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>