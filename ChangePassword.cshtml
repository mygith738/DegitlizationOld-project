@using Digitalization.Models.UserModel
@model ChangePasswordModel

@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
<!-- css -->
<link rel="stylesheet" href="~/assets/css/user/common-with-hover.css">

<main>

    <div class="container my-2">
        <br><br><br><br><br><br>
        <div class="row mt-5">
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
            <div class="main col-lg-6 col-md-8 col-sm-6 m-1">
                <div class="m-4 pt-3 text-center">
                    <h2 class="">Change Password</h2>
                    <h5 id="ErrorMessage" class="text-danger">@ViewBag.ExceptionError</h5>
                </div>
                <form asp-action="ChangePassword" class="m-4 pb-5" onsubmit="return validateForm()" name="change-form">
                    <div class="mb-3">
                        @*this field is just to pass StaffNumber to model and hidden*@
                        @*value to this field is passed from session*@
                        <input type="text" asp-for="StaffNumber" value="@HttpContextAccessor.HttpContext.Session.GetInt32("StaffNumber")" hidden>

                        <label for="OldPassword" class="form-label">Old Password</label>
                        <input type="password" asp-for="OldPassword" class="form-control" id="OldPassword" onkeypress="clearoldpasswordvalidation()" onclick="clearoldpasswordvalidation()" placeholder="Enter Old Password here.." autofocus>
                        <span id="validateoldpassword" class="text-danger">@ViewBag.ErrorMessage</span>
                    </div>
                    <div class="mb-3">
                        <label for="NewPassword" class="form-label">New Password</label>
                        <input type="password" asp-for="NewPassword" class="form-control" id="NewPassword" onkeypress="clearnewpasswordvalidation()" onclick="clearnewpasswordvalidation()" placeholder="Enter New Password here..">
                        <span id="validatenewpassword" class="text-danger">@ViewBag.NewPasswordError</span>
                    </div>
                    <div class="mb-3">
                        <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input type="password" asp-for="ConfirmPassword" class="form-control" onkeypress="clearconfirmpasswordvalidation()" onclick="clearconfirmpasswordvalidation()" id="ConfirmPassword" placeholder="Please Confirm Your Password..">
                        <span id="validateconfirmpassword" class="text-danger">@ViewBag.ConfirmPasswordError</span>
                    </div>
                    <div class="row mb-3 mx-2">
                        <div class="form-check col">
                            <input type="checkbox" class="form-check-input" id="showPassword" onclick="togglePassword()">
                            <label class="form-check-label" for="showPassword">Show Password</label>
                        </div>
                    </div>
                    @*<div class="row">
                        <div class="text-left col">
                            <button type="submit" class="btn btn-primary px-5 mt-2 submit-btn">Submit</button>
                        </div>
                        <div class="text-right col">
                            <a class="btn btn-primary px-5 mt-2 home-btn" href="@Url.Action("Home","User")">Dashboard</a>
                        </div>
                    </div>*@
                    <div class="row">
                        <div class="text-left col">
                            <a class="btn btn-primary px-5 mt-2 home-btn" href="@Url.Action("Home","User")">Dashboard</a>                           
                        </div>
                        <div class="text-right col">
                            <button type="submit" class="btn btn-primary px-5 mt-2 submit-btn">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
        </div>
    </div>
</main>



<script src="~/assets/js/user/change-password.js"></script>