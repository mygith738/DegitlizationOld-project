@using Digitalization.Models.UserModel
@model List<IndentModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Home","User")" style="text-decoration: none">User</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("IDRIndent","User")" style="text-decoration: none">IDR Indent</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("AssignedRequestWithoutFilter","User")" style="text-decoration: none">AssignedRequest</a></li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                    <!-- @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@ -->
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Assigned Requests</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">
                                    <a class="btn btn-primary text-right mt-3" href="@Url.Action("AssignedRequest","User")">Filter Rows</a>
                                </div>
                            </div>
                            <hr>
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <table class="table table-bordered text-center" id="DataTable">
                                        <thead class="p-3">
                                            <tr>
                                                <th scope="col">Sl. No.</th>
                                                <th scope="col">Indent ID</th>
                                                <th scope="col">Staff Number</th>
                                                <th scope="col">First Name</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Group Name</th>
                                                <th scope="col">Center Name</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Count() > 0)
                                            {
                                                @foreach (var indent in Model)
                                                {
                                                    <tr>
                                                        <td> @( ((Int32) 1) + @Model.IndexOf(indent) ) </td>
                                                        <td scope="row">@indent.IndentID</td>
                                                        <td>@indent.SenderStaffNumber</td>
                                                        <td>@indent.SenderFirstName</td>
                                                        <td>@indent.SenderDesignation</td>
                                                        <td>@indent.FromGroupName</td>
                                                        <td>@indent.FromCenterName</td>
                                                        <td>
                                                            @if(@indent.OldIndentStatus == "RAISED" || @indent.OldIndentStatus == "REOPEN")
                                                            {
                                                                <a class="btn btn-warning text-light">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "FORWARDED")
                                                            {
                                                                <a class="btn text-light" style="background-color: #5F9EA0">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "APPROVED")
                                                            {
                                                                <a class="btn text-light" style="background-color: #008B8B">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "ASSIGNED")
                                                            {
                                                                <a class="btn btn-primary text-light">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "WORK IN PROGRESS")
                                                            {
                                                                <a class="btn text-light" style="background-color: #A52A2A">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "COMPLETED")
                                                            {
                                                                <a class="btn btn-success text-light">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "ACCEPTED & CLOSED")
                                                            {
                                                                <a class="btn text-light" style="background-color: #4169E1">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "REJECTED")
                                                            {
                                                                <a class="btn btn-danger text-light">@indent.OldIndentStatus</a>
                                                            }
                                                            else if(@indent.OldIndentStatus == "CANCELLED")
                                                            {
                                                                <a class="btn text-light" style="background-color: #800080">@indent.OldIndentStatus</a>
                                                            }
                                                        </td>
                                                        <td>
                                                            <a href="@Url.Action("ViewAssignedIndentRequest","User",new { IndentID = indent.IndentID})" class="btn btn-primary">View</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript" src="~/assets/js/user/assigned-request.js"></script>