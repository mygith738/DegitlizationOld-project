@using Digitalization.Models.AdminModel
@model List<EmployeeModel>
@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}
<link rel="stylesheet" href="~/assets/css/admin/common.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")" style="text-decoration: none">Admin</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("EmployeeSearch","Admin")" style="text-decoration: none">EmployeeSearch</a></li>
                                </ol>
                            </nav>
                            <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                            <div class="row">
                                <div class="col-3"></div>
                                <div class="col-5">
                                    <h2 class="text-center">Employee Search</h2>
                                    <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">

                                </div>
                            </div>
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <table class="table table-bordered text-center" id="DataTable">
                                        <thead class="p-3">
                                            <tr>
                                                <th scope="col">Sl. No.</th>
                                                <th scope="col">Staff Number</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Employee Category</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Group Name</th>
                                                <th scope="col">Center Name</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int i = 1;
                                            }
                                            @if (Model.Count() > 0)
                                            {
                                                @for (var row = 0; row < Model.Count(); row++)
                                                {
                                                    <tr>
                                                        <td> @i </td>
                                                        <td scope="row">@Model[row].StaffNumber</td>
                                                        <td>@Model[row].FirstName</td>
                                                        <td>@Model[row].EmployeeCategory</td>
                                                        <td>@Model[row].Designation</td>
                                                        <td>
                                                            @if (@Model[row].GroupName == "Center Head")
                                                            {
                                                                @Model[row].GroupName
                                                            }
                                                            else
                                                            {
                                                                @Model[row].GroupName
                                                            }
                                                        </td>
                                                        <td>@Model[row].CenterName</td>
                                                        <td>
                                                            <a href="@Url.Action("EmployeeSearchDetails","Admin",new { StaffNumber = Model[row].StaffNumber})" class="btn btn-primary">View</a>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/admin/employee-search-data.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>