@using Digitalization.Models
@model HolidaysModel

<link  rel= "stylesheet" href="~/assets/css/admin/common.css"/>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}
<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <nav aria-label="breadcrumb" class="pl-3">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Add Holidays</li>
                            </ol>
                        </nav>
                        <h2 class="text-center">Add Holidays</h2>
                        <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                        <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                        <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                        <hr>
                        <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="AddHolidays" class="m-4 pb-5">
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <div class="row">
                                        <div class="row m-1 border rounded-top mt-4 p-3">
                                            <div class="row">
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="Year" class="form-label">Year</label>
                                                    <select class="form-control" asp-for="Year" id="Year" onclick="clearvalidateyear()" onchange="toggleDateValue()">
                                                        <option value="Null">Please select year</option>
                                                    </select>
                                                    <span id="validateyear" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="TypeOfHoliday" class="form-label">Type Of Holiday</label>
                                                    <select class="form-control" id="TypeOfHoliday" asp-for="TypeOfHoliday" onclick="clearvalidatetypeofholiday()">
                                                        <option value="Null">Please select holiday type</option>
                                                        <option value="RH">Restricted Holiday</option>
                                                        <option value="CH">Closed Holiday</option>
                                                    </select>
                                                    <span id="validatetypeofholiday" class="text-danger"></span>
                                                </div>
                                            </div>
                                            @for(var i=0;i<30;i++)
                                            {
                                                var slno = i + 1;
                                                <div id="OccasionDiv(@i)">
                                                    <div class="row">
                                                        <div class="col-md-1 col-lg-1 col-sm-1 col-1 mb-3">
                                                            <label for="SlNo" class="form-label">Sl.No</label>
                                                            <input type="number" class="form-control" value="@slno" readonly/>
                                                        </div>
                                                        <div class="col-md-2 col-lg-2 col-sm-2 col-2 mb-3">
                                                            <label for="Date" class="form-label">Date</label>
                                                            <input type="date" class="form-control" id="Date(@i)" asp-for="@Model.HolidayList[i].Date" onclick="clearvalidatedate(@i)" onchange="getDayOfWeek(@i)"/>
                                                            <span id="validatedate(@i)" class="text-danger"></span>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-3 col-3 mb-3">
                                                            <label for="Day" class="form-label">Day</label>
                                                            <input type="text" class="form-control" id="Day(@i)" readonly asp-for="@Model.HolidayList[i].Day"/>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="Occasion" class="form-label">Occasion</label>
                                                            <input type="text" class="form-control" id="Occasion(@i)" asp-for="@Model.HolidayList[i].Occassion" onclick="clearvalidateoccasion(@i)"/>
                                                            <span id="validateoccasion(@i)" class="text-danger"></span>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mt-4">
                                                            <button type="button" class="btn btn-primary mt-2" id="addbutton(@i)" onclick="adddiv(@i)">Add</button>
                                                            @if (i != 0)
                                                            {
                                                                <button type="button" class="btn btn-primary mt-2" id="removebutton(@i)" onclick="removediv(@i)">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        
                                    </div>
                                    <button type="submit" class="btn btn-primary float-end px-5 mt-2" onclick="return validateForm()">Submit</button>
                                    @*<a class="btn btn-primary px-5 mt-2 ml-4" href="@Url.Action("ViewGroups","Admin")">Go Back</a>*@
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>   

<script src="~/assets/js/admin/add-holidays.js"></script>