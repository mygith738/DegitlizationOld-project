                                                                <span id="validateexperience(@row)" class="text-danger"></span>
                                                            </div>
                                                            <div class="col-2">
                                                                <textarea class="form-control" asp-for="@Model.PurchaseVendors[row].VendorWebsite" id="Website(@row)" class="form-control" onclick="clearvalidatewebsite(@row)" onkeypress="clearvalidatewebsite(@row)"></textarea>
                                                                <span id="validatewebsite(@row)" class="text-danger"></span>
                                                            </div>
                                                            <div class="col-2">
                                                                <textarea asp-for="@Model.PurchaseVendors[row].Address" id="Address(@row)" class="form-control" onclick="clearvalidateaddress(@row)" onkeypress="clearvalidateaddress(@row)"></textarea>
                                                                <span id="validateaddress(@row)" class="text-danger"></span>
