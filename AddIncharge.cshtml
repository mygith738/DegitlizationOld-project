@using Digitalization.Models.AdminModel
@model InchargeModel

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <nav aria-label="breadcrumb" class="pl-3">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("ViewInchargeData","Admin")" style="text-decoration: none">ViewIncharge</a></li>
                                <li class="breadcrumb-item active" aria-current="page">AddIncharge</li>
                            </ol>
                        </nav>
                        <h2 class="text-center">Add Incharge</h2>
                        <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                        <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                        <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                        <hr>
                        <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="AddIncharge" class="m-4 pb-5" name="register-form">
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <div class="row">
                                        <div class="row m-1 border rounded-top mt-4 p-3">
                                            <div class="row">
                                                <div class="col-3 mb-3 row">
                                                    <label for="GroupID" class="form-label">Group Name</label>
                                                    @if (Model.Groups.Count() > 0)
                                                    {
                                                        <select asp-for="GroupID" asp-items="@(new SelectList(Model.Groups,"GroupId","GroupName"))" class="form-control" id="GroupID" onchange="cleargroupidvalidation()" onclick="cleargroupidvalidation()">
                                                            <option value="Null">Please Select Group</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <select asp-for="GroupID" class="form-control" id="GroupID">
                                                            <option value="Null">Please Select Group</option>
                                                        </select>
                                                    }
                                                    <span id="validategroupid" class="text-danger">@ViewBag.CenterNameError</span>
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                    <label for="InchargeStaffNumber" class="form-label">Incharge StaffNumber</label>
                                                    <input type="number" onwheel="this.blur()" asp-for="InchargeStaffNumber" class="form-control" id="InchargeStaffNumber" onclick="clearinchargestaffnumbervalidation()" onkeypress="clearinchargestaffnumbervalidation()">
                                                    <span id="validateinchargestaffnumber" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary float-end px-5 mt-2" onclick="return validateForm()">Submit</button>
                                    <a class="btn btn-primary px-5 mt-2 ml-4" href="@Url.Action("ViewInchargeData","Admin")">Go Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/admin/add-incharge.js"></script>