@using Digitalization.Models.UserModel
@model List<AttendanceModel>

@using Microsoft.AspNetCore.Http;

@inject IHttpContextAccessor HttpContextAccessor

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

                


<!-- css -->
<link rel="stylesheet" href="~/assets/css/user/login-page.css">

<main>

    <div class="container my-2">
        <br><br><br><br>
        <div class="row mt-5">
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
            <div class="main col-lg-6 col-md-8 col-sm-6 m-1">
                @*<button onclick="window.print();" class="btn btn-primary float-right mt-3">
                    <svg width="16" height="16" fill="currentColor" class="bi bi-printer-fill" viewBox="0 0 16 16">
                        <path d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2H5zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1z" />
                        <path d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2V7zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                    </svg>
                </button>*@
                <div class="m-4 pt-3 text-center">
                    <h2 class="">Attendance</h2>
                    <h5 id="ErrorMessage" class="text-danger">@ViewBag.ExceptionError</h5>
                    <h5 id="SuccessMessage" class="text-success">@ViewBag.SuccessMessage</h5>
                </div>
                <form method ="GET" asp-action="AttendanceData" class="m-4 pb-5" onsubmit="return validateForm()" name="login-form">
                    <div class="mb-3">
                        <label for="staffnumber" class="form-label">Staff Number</label>
                        <input type="number" onwheel="this.blur()" min="1" class="form-control" id="staffnumber" name="StaffNumber" placeholder="Enter Staff Number here.." onkeypress="clearstaffnumbervalidation();" onclick="clearstaffnumbervalidation();" autofocus>
                        <span id="validatestaffnumber" class="text-danger">@ViewBag.StaffNumberError</span>
                    </div>
                    <div class="row">
                        <div class="text-left col">
                            <a class="btn btn-primary px-5 mt-2 home-btn" href="@Url.Action("Index","User")">Home</a>
                        </div>
                        <div class="text-right col">
                            <button type="submit" class="btn btn-primary px-5 mt-2 submit-btn">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-3 col-sm-3 col-md-2"></div>
        </div>
    </div>
</main>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });

    $('#DataTable').dataTable( {
        "pageLength": 50
      } );
</script>