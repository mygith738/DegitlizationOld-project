@using Microsoft.AspNetCore.Http;

@inject IHttpContextAccessor HttpContextAccessor

<!-- css -->
<link rel="stylesheet" href="~/assets/css/user/common-landing-pages.css">

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <nav aria-label="breadcrumb" class="ms-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("Home","User")" style="text-decoration: none">User</a></li>
                            <li class="breadcrumb-item active" aria-current="page">VehicleIndent</li>
                        </ol>
                    </nav>
                    <div class="row ms-5 mb-4">
                        <div class="row mb-4 border p-3 idrrequest">
                            <h4>Vehicle Indent</h4>
                            <div class="col-sm-4 col-md-4 col-lg-3 col-xl-2 mr-3 mt-2">
                                <div class="box py-3 row hvr-grow-shadow myidrrequest text-center">
                                     <a href="@Url.Action("RaiseVehicleIndent","User")" style="text-decoration: none" class="text-black">
                                        <p>Raise Vehicle Indent</p>
                                     </a>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-4 col-lg-3 col-xl-2 mr-3 mt-2">
                                <div class="box py-3 row hvr-grow-shadow myidrrequest text-center">
                                     <a href="@Url.Action("MyVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">
                                        <p>My Requests</p>
                                     </a>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-4 col-lg-3 col-xl-2 mr-3 mt-2">
                                <div class="box py-3 row hvr-grow-shadow myidrrequest text-center">
                                     <a href="@Url.Action("PendingVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">
                                        <p>Pending Requests</p>
                                     </a>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-4 col-lg-3 col-xl-2 mr-3 mt-2">
                                <div class="box py-3 row hvr-grow-shadow myidrrequest text-center">
                                     <a href="@Url.Action("AssignedVehicleRequestWithoutFilter","User")" style="text-decoration: none" class="text-black">
                                        <p>Assigned Requests</p>
                                     </a>
                                </div>
                            </div>
                            @if (@HttpContextAccessor.HttpContext.Session.GetString("Role") == "Authority" ||
                                   @HttpContextAccessor.HttpContext.Session.GetString("Role") == "AdminAuthority")
                            {
                                <div class="col-sm-4 col-md-4 col-lg-3 col-xl-2 mr-3 mt-2">
                                    <div class="box py-3 row hvr-grow-shadow myidrrequest text-center">
                                         <a href="@Url.Action("MyGroupVehicleIndentRequestWithoutFilter","Authority")" style="text-decoration: none" class="text-black">
                                            <p>My Group Requests</p>
                                         </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>