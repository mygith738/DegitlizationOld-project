@using Digitalization.Models.AuthorityModel
@model List<PermissionSlipModel> 

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <nav aria-label="breadcrumb" class="pl-3">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">User</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("PermissionSlip","User")" style="text-decoration: none">Permission</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("MyGroupPermissionRequestWithoutFilter","Authority")" style="text-decoration: none">MyGroupPermissionRequest</a></li>
                                <li class="breadcrumb-item active" aria-current="page">ViewMyGroupPermissionRequest</li>
                            </ol>
                        </nav>
                        <h2 class="text-center">View My Group/Center Permission Request</h2>
                        <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                        <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                        <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                        <hr>
                        <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="ViewMyGroupPermissionRequest" class="m-4 pb-5" name="request-form">
                            @if(Model != null)
                            {
                                bool flag = true;

                                @for (var row = 0; row < Model.Count(); row++)
                                {
                                    @if(flag)
                                    {
                                        flag = false;

                                        <div class="tab-content">
                                            <div class="" id="userdetails">
                                                <div class="row"> 
                                                    <!-- hidden fields start -->
                                                    <div class="row m-1 border rounded-top mt-4 p-3" style="display: none">
                                                        <div class="row">
                                                             @*<div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="AlternateAppliedFor" class="form-label">Applied For</label>
                                                                <input type="date" asp-for="@Model[row].Date" class="form-control" id="AlternateAppliedFor" readonly>
                                                             </div>*@
                                                        </div>                                            
                                                    </div>
                                                    <!-- hidden fields end -->
                                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <div class="row">                                               
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="PermissionID" class="form-label">Permission ID</label>
                                                                <input type="text" asp-for="@Model[row].PermissionID" class="form-control" id="PermissionID" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="AppliedOn" class="form-label">Applied On</label>
                                                                <input type="text" asp-for="@Model[row].PermissionRaisedDateTime" class="form-control" id="AppliedOn" readonly>
                                                            </div>
                                                        </div>                                            
                                                    </div>
                                                     <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <div class="row">                                               
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="StaffNumber" class="form-label">StaffNumber</label>
                                                                <input type="text" asp-for="@Model[row].StaffNumber" class="form-control" id="StaffNumber" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="Name" class="form-label">Name</label>
                                                                <input type="text" asp-for="@Model[row].StaffName" class="form-control" id="Name" readonly>
                                                            </div>
                                                             <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="Designation" class="form-label">Designation</label>
                                                                <input type="text" asp-for="@Model[row].StaffDesignation" class="form-control" id="Designation" readonly>
                                                            </div>
                                                        </div>
                                                        <div class="row">                                               
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="GroupName" class="form-label">Group Name</label>
                                                                <input type="text" asp-for="@Model[row].GroupName" class="form-control" id="GroupName" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="CenterName" class="form-label">Center Name</label>
                                                                <input type="text" asp-for="@Model[row].CenterName" class="form-control" id="CenterName" readonly>
                                                            </div>
                                                        </div>        
                                                    </div>
                                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <div class="row">                                               
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3" style="display: none">
                                                                <label for="PermissionType" class="form-label">Permission Type</label>
                                                                <input type="text" asp-for="@Model[row].PermissionType" class="form-control" id="PermissionType" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="PermissionType" class="form-label">Permission Type</label>
                                                                @if(@Model[row].PermissionType == "OD")
                                                                {
                                                                    <input type="text" value="OD" class="form-control" id="PermissionType" readonly>
                                                                }
                                                                else if(@Model[row].PermissionType == "AL")
                                                                {
                                                                    <input type="text" value="Attended Late" class="form-control" id="PermissionType" readonly>
                                                                }
                                                                else if(@Model[row].PermissionType == "GE")
                                                                {
                                                                    <input type="text" value="Go Early" class="form-control" id="PermissionType" readonly>
                                                                }
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="AlternateAppliedFor" class="form-label">Applied For</label>
                                                                <input type="date" asp-for="@Model[row].Date" class="form-control" id="AlternateAppliedFor" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="FromTime" class="form-label">From Time</label>
                                                                <input type="text" asp-for="@Model[row].AlternateFromTime" class="form-control" id="FromTime" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="ToTime" class="form-label">To Time</label>
                                                                <input type="text" asp-for="@Model[row].AlternateToTime" class="form-control" id="ToTime" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="TotalDuration" class="form-label">Total Duration</label>
                                                                <input type="text" asp-for="@Model[row].TotalDuration" class="form-control" id="TotalDuration" readonly>
                                                            </div>
                                                        </div>
                                                        <div class="row">                                               
                                                            <div class="col-md-6 col-lg-6 col-sm-6 col-6 mb-3">
                                                                <label for="Reason" class="form-label">Reason</label>
                                                                <textarea asp-for="@Model[row].Reason" class="form-control" id="Reason" readonly></textarea>
                                                            </div>
                                                            <div class="col-md-6 col-lg-6 col-sm-6 col-6 mb-3">
                                                                <label for="Remarks" class="form-label">Remarks</label>
                                                                <textarea asp-for="@Model[row].OldRemarks" class="form-control" id="Remarks" readonly></textarea>
                                                            </div>
                                                        </div>        
                                                    </div>
                                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <h5 class="text-primary text-center">Reporting Officer</h5>
                                                         <div class="row">                                               
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="ActionTakenByStaffNumber" class="form-label">StaffNumber</label>
                                                                <input type="text" asp-for="@Model[row].ReportingOfficer" class="form-control" id="ActionTakenByStaffNumber" readonly>
                                                            </div>
                                                            <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="ActionTakenByName" class="form-label">Name</label>
                                                                <input type="text" asp-for="@Model[row].ReportingOfficerName" class="form-control" id="ActionTakenByName" readonly>
                                                            </div>
                                                             <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                                <label for="ActionTakenByDesignation" class="form-label">Designation</label>
                                                                <input type="text" asp-for="@Model[row].ReportingOfficerDesignation" class="form-control" id="ActionTakenByDesignation" readonly>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <h5 class="text-center text-primary">Assigned To</h5>
                                                        <div class="col-xl-3 col-lg-4 col-md-6 mb-3">
                                                            <label for="RecieverStaffNumber" class="form-label">Staff Number</label>
                                                            <input type="text" id="RecieverStaffNumber" asp-for="@Model[row].RecieverStaffNumber" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-3 col-lg-4 col-md-6 mb-3">
                                                            <label for="RecieverName" class="form-label">First Name</label>
                                                            <input type="text" asp-for="@Model[row].RecieverName" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-3 col-lg-4 col-md-6 mb-3">
                                                            <label for="RecieverName" class="form-label">Designation</label>
                                                            <input type="text" asp-for="@Model[row].RecieverDesignation" class="form-control" readonly>
                                                        </div>
                                                    </div>
                                                </div>
                                                <a class="btn btn-primary px-5 mt-2 ml-4" href="@Url.Action("MyGroupPermissionRequestWithoutFilter","Authority")">Go Back</a>
                                            </div>
                                            <h5 class="text-center mt-4 text-primary">Permission Status</h5>
                                            <div class="m-1 border rounded-top mt-4 p-3">
                                                @foreach (var permission in Model)
                                                {
                                                    <div class="row">
                                                        <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                            <label for="Status" class="form-label">Status</label>
                                                            <input type="text" asp-for="@permission.OldStatus" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                            <label for="StaffNumber" class="form-label">Staff Number</label>
                                                            <input type="text" asp-for="@permission.ActionTakenByStaffNumber" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                            <label for="FirstName" class="form-label">Name</label>
                                                            <input type="text" asp-for="@permission.ActionTakenByName" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                            <label for="Designation" class="form-label">Designation</label>
                                                            <input type="text" asp-for="@permission.ActionTakenByDesignation" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-3 col-lg-5 col-md-6 mb-3">
                                                            <label for="Date" class="form-label">Date</label>
                                                            <input type="datetime" asp-for="@permission.DateTime" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                                            <label for="Remarks" class="form-label">Remarks</label>
                                                            <textarea class="form-control" asp-for="@permission.OldRemarks" readonly></textarea>
                                                        </div>
                                                    </div>
                                                    <hr />
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/authority/view-my-group-permision-request.js"></script>