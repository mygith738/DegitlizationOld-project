@using Digitalization.Models.AdminModel
@model List<EmployeeModel>
@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<meta name="viewport" content="width=1520" />

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")" style="text-decoration: none">Admin</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("EmployeeRequest","Admin")" style="text-decoration: none">EmployeeRequest</a></li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">
                                    @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Employee Requests</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">

                                </div>
                            </div>
                            <hr>
                            @if (ViewBag.IsFiltered != null && ViewBag.IsFiltered == false)
                            {
                                <form asp-action="EmployeeRequest" onsubmit="return validateForm()" method="post" name="request-page">
                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                        <div class="col-3 mb-3">
                                            <label for="Year" class="form-label">Year</label>
                                            <select class="form-control" name="Year" id="Year" onchange="clearyearvalidation()" onclick="clearyearvalidation()">
                                                <option value="Null">Please select Year</option>
                                            </select>
                                            <span id="validateyear" class="text-danger"></span>
                                        </div>
                                        <div class="col-3 mb-3">
                                            <label for="Month" class="form-label">Month</label>
                                            <select class="form-control" name="Month" id="Month" onchange="clearmonthvalidation()" onclick="clearmonthvalidation()">
                                                <option value="Null">Please select Month</option>
                                                <option value="0">All</option>
                                                <option value="1">January</option>
                                                <option value="2">February</option>
                                                <option value="3">March</option>
                                                <option value="4">April</option>
                                                <option value="5">May</option>
                                                <option value="6">June</option>
                                                <option value="7">July</option>
                                                <option value="8">August</option>
                                                <option value="9">September</option>
                                                <option value="10">October</option>
                                                <option value="11">November</option>
                                                <option value="12">December</option>
                                            </select>
                                            <span id="validatemonth" class="text-danger"></span>
                                        </div>
                                        <div class="col-3 mb-3">
                                            <label for="Status" class="form-label">Status</label>
                                            <select class="form-control" name="Status" id="Status" onchange="clearstatusvalidation()" onclick="clearstatusvalidation()">
                                                <option value="Null">Please select Status</option>
                                                <option value="S">SUBMITTED</option>
                                                <option value="P">PENDING FOR APPROVAL</option>
                                                <option value="A">APPROVED</option>
                                                <option value="D">DECLINED</option>
                                            </select>
                                            <span id="validatestatus" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="m-2">
                                        <button type="submit" class="btn btn-primary px-5">Search</button>
                                    </div>
                                </form>
                            }
                            else if (ViewBag.IsFiltered != null && ViewBag.IsFiltered == true)
                            {
                                <div class="tab-content">
                                    <div class="" id="userdetails">
                                        <table class="table table-bordered text-center" id="DataTable">
                                            <thead class="p-3">
                                                <tr>
                                                    <th scope="col">Sl. No.</th>
                                                    <th scope="col">Staff Number</th>
                                                    <th scope="col">First Name</th>
                                                    <th scope="col">Last Name</th>
                                                    <th scope="col">Employee Category</th>
                                                    <th scope="col">Designation</th>
                                                    <th scope="col">Group Name</th>
                                                    <th scope="col">Center Name</th>
                                                    <th scope="col">Status</th>
                                                    <th scope="col">View</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @if (Model.Count() > 0)
                                                {
                                                    @foreach (var employee in Model)
                                                    {
                                                        <tr>
                                                            <td> @( ((Int32) 1) + @Model.IndexOf(employee) ) </td>
                                                            <td scope="row">@employee.StaffNumber</td>
                                                            <td>@employee.FirstName</td>
                                                            <td>@employee.LastName</td>
                                                            <td>@employee.EmployeeCategory</td>
                                                            <td>@employee.Designation</td>
                                                            <td>@employee.GroupName</td>
                                                            <td>@employee.CenterName</td>
                                                            <td>
                                                                @if (employee.Status == 'A')
                                                                {
                                                                    <button type="button" class="btn btn-success">APPROVED</button>
                                                                }
                                                                else if (employee.Status == 'P')
                                                                {
                                                                    <button type="button" class="btn btn-warning">PENDING</button>
                                                                }
                                                                else if (employee.Status == 'D')
                                                                {
                                                                    <button type="button" class="btn btn-danger">DECLINED</button>
                                                                }
                                                                else if (employee.Status == 'S')
                                                                {
                                                                    <button type="button" class="btn btn-primary">SUBMITTED</button>
                                                                }
                                                            </td>
                                                            <td>
                                                                <a href="@Url.Action("EmployeeRequestData","Admin",new { StaffNumber = employee.StaffNumber})" class="btn btn-primary">View</a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/assets/js/admin/employee-request.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>