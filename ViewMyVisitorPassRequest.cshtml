@using Digitalization.Models.UserModel
@model List<VisitorPassModel>

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />

<script src="~/assets/js/webcam/webcam.js"></script>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <nav aria-label="breadcrumb" class="pl-3">
                            <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">User</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("VisitorPass","User")" style="text-decoration: none">VisitorPass</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("MyVisitorPassRequestWithoutFilter","User")" style="text-decoration: none">MyVisitorPassRequest</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">ViewMyVisitorPassRequest</li>
                                </ol>
                        </nav>
                        <h2 class="text-center">View My Visitor Pass</h2>
                        <p class="text-center text-danger">@ViewBag.ExceptionError</p>
                        <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                        <span id="ErrorMessage" class="text-danger">@ViewBag.Error</span>
                        <hr>
                        <form method="post" onsubmit="return validateForm()" enctype="multipart/form-data" asp-action="ViewMyVisitorPassRequest" class="m-4 pb-5" name="register-form">
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    @for(var row=0;row<1;row++)
                                    {
                                        <div class="row">
                                            <div class="row m-1 border rounded-top mt-4 p-3">
                                                <!-- hidden field start -->
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="EmployeeGroupID" class="form-label">EmployeeGroupID</label>
                                                    <input type="number" asp-for="@Model[row].EmployeeGroupID" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="EmployeeCenterID" class="form-label">EmployeeCenterID</label>
                                                    <input type="number" asp-for="@Model[row].EmployeeCenterID" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="IsCarryingLaptop" class="form-label">IsCarryingLaptop</label>
                                                    <input type="text" asp-for="@Model[row].IsCarryingLaptop" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="IsCarryingPendrive" class="form-label">IsCarryingPendrive</label>
                                                    <input type="text" asp-for="@Model[row].IsCarryingPendrive" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="IsCarryingOther" class="form-label">IsCarryingOther</label>
                                                    <input type="text" asp-for="@Model[row].IsCarryingOther" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="OtherCarryingItem" class="form-label">OtherCarryingItem</label>
                                                    <input type="text" asp-for="@Model[row].OtherCarryingItem" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="IsIDCardReturned" class="form-label">IsIDCardReturned</label>
                                                    <input type="text" asp-for="@Model[row].IsIDCardReturned" class="form-control">
                                                </div>
                                                <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3" style="display: none">
                                                    <label for="SignatureFileLocation" class="form-label">SignatureFileLocation</label>
                                                    <input type="text" asp-for="@Model[row].SignatureFileLocation" class="form-control">
                                                </div>
                                                <!-- hidden field end -->
                                                <div class="row">
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="PassID" class="form-label">Visitor PassID</label>
                                                        <input type="text" asp-for="@Model[row].PassID" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="RaisedDateTime" class="form-label">RaisedDateTime</label>
                                                        <input type="text" asp-for="@Model[row].RaisedDateTime" class="form-control" readonly>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <h5 class="mb-2 text-primary">Data entry done by</h5>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderStaffNumber" class="form-label">Staff Number</label>
                                                        <input type="text" asp-for="@Model[row].SenderStaffNumber" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderFirstName" class="form-label">Name</label>
                                                        <input type="text" asp-for="@Model[row].SenderFirstName" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderDesignation" class="form-label">Designation</label>
                                                        <input type="text" asp-for="@Model[row].SenderDesignation" class="form-control" readonly>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row m-1 border rounded-top mt-4 p-3">
                                                <div class="row">
                                                    <h5 class="mb-2 text-primary">To meet</h5>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4  mb-3">
                                                        <label for="EmployeeStaffNumber" class="form-label">Employee Staff Number</label>
                                                        <input type="number" asp-for="@Model[row].EmployeeStaffNumber" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderFirstName" class="form-label">Employee Name</label>
                                                        <input type="text" asp-for="@Model[row].EmployeeName" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderCenterName" class="form-label">Employee Center</label>
                                                        <input type="text" asp-for="@Model[row].EmployeeCenterName" class="form-control" readonly>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                        <label for="SenderGroupName" class="form-label">Employee Group</label>
                                                        <input type="text" asp-for="@Model[row].EmployeeGroupName" class="form-control" readonly>
                                                    </div>
                                                </div>
                                            </div>
                                            @{
                                                int i = 0;
                                                int VisitorCount = 1;
                                            }
                                            @foreach(var visitor in @Model[row].VisitorsModel)
                                            {
                                                VisitorCount = i + 1;

                                                <div class="row m-1 border rounded-top mt-4 p-3">
                                                    <h4 class="text-center mb-3 text-primary">Visitor - @VisitorCount</h4>
                                                    <div class="row m-1 border rounded-top mt-4 p-3">
                                                        <div class="col-4"></div>
                                                        <div class="col-3">
                                                            <img src="@Model[row].VisitorsModel[i].AlternateVisitorImageLocation" class="rounded float-end" alt="" height="250" />
                                                            @*<img src="~/assets/images/user.jpg" class="rounded float-end" height="250" />*@
                                                        </div>
                                                        <div class="col-3"></div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorName" class="form-label">Visitor Name</label>
                                                            <input type="text" asp-for="@Model[row].VisitorsModel[i].VisitorName" class="form-control" readonly>
                                                        </div> 
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorDesignation" class="form-label">Visitor Designation</label>
                                                            <input type="text" asp-for="@Model[row].VisitorsModel[i].VisitorDesignation" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorMobileNumber" class="form-label">Visitor Mobile Number</label>
                                                            <input type="number" asp-for="@Model[row].VisitorsModel[i].VisitorMobileNumber" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorEmailID" class="form-label">Visitor Email ID</label>
                                                            <input type="text" asp-for="@Model[row].VisitorsModel[i].VisitorEmailID" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorAge" class="form-label">Visitor Age</label>
                                                            <input type="text" asp-for="@Model[row].VisitorsModel[i].VisitorAge" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorGender" class="form-label">Visitor Gender</label>
                                                            <input type="text" asp-for="@Model[row].VisitorsModel[i].VisitorGender" class="form-control" readonly>
                                                        </div>
                                                        <div class="col-md-3 col-lg-3 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorIDCardNumber" class="form-label">Visitor ID Card Number</label>
                                                            <input type="number" asp-for="@Model[row].VisitorsModel[i].VisitorIDCardNumber" class="form-control" readonly>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-4 col-lg-4 col-sm-4 col-4 mb-3">
                                                            <label for="VisitorInstitution" class="form-label">Visitor Organization Name</label>
                                                            <textarea asp-for="@Model[row].VisitorsModel[i].VisitorInstitution" class="form-control" readonly></textarea>
                                                        </div>  
                                                        <div class="col-md-4 col-lg-4 col-sm-4 col-4 mb-3">
                                                            <label for="@Model[row].VisitorAddress" class="form-label">Visitor Address</label>
                                                            <textarea asp-for="@Model[row].VisitorsModel[i].VisitorAddress" class="form-control" readonly></textarea>
                                                        </div>
                                                        @if(@ViewBag.SignatureFileLocation != null && i==0)
                                                        {
                                                            <div class="col-md-4 col-lg-4 col-sm-4 col-4 mb-3">
                                                                <p class="">Signature of Visitor 1</p>
                                                                <img src="@ViewBag.SignatureFileLocation" height="200" />
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                i++;
                                            }
                                            <div class="row m-1 border rounded-top mt-4 p-3">
                                                <div class="col-md-4 col-lg-4 col-sm-4 col-4  mb-3">
                                                    <h6>Visitor is carrying</h6>
                                                    @if(@Model[row].IsCarryingLaptop !="No" ||
                                                        @Model[row].IsCarryingPendrive !="No" ||
                                                        @Model[row].IsCarryingOther !="No")
                                                    {
                                                        @if(@Model[row].IsCarryingLaptop == "Yes") 
                                                        {
                                                            <span>* Laptop</span> <br />
                                                        }
                                                        @if(@Model[row].IsCarryingPendrive == "Yes") 
                                                        {
                                                            <span>* Pendrive</span> <br />
                                                        }
                                                        @if(@Model[row].IsCarryingOther == "Yes") 
                                                        {
                                                            <span>* @Model[row].OtherCarryingItem</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span>* None</span>
                                                    }
                                                </div>
                                                <div class="col-md-4 col-lg-4 col-sm-4 col-4  mb-3">
                                                    <label for="PurposeOfVisit" class="form-label">Purpose of visit</label>
                                                    <textarea class="form-control" asp-for="@Model[row].PurposeOfVisit" id="PurposeOfVisit" readonly></textarea>
                                                </div>
                                                <div class="col-md-4 col-lg-4 col-sm-4 col-4  mb-3">
                                                    <label for="Remarks" class="form-label">Remarks</label>
                                                    <textarea class="form-control" asp-for="@Model[row].OldRemarks" readonly></textarea>
                                                </div>
                                                @if(@Model[row].OldStatus=="VISITOR LEFT THE INSTITUTE")
                                                {
                                                    if(@Model[row].IsIDCardReturned == "Yes")
                                                    {
                                                        <span class="text-info">Visitor has returned the ID Card</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">Visitor has not returned the ID Card</span>
                                                    }
                                                }
                                            </div>
                                            @if(@Model[row].OldStatus!="CANCELLED" && @Model[row].OldStatus!="VISITOR LEFT THE INSTITUTE"
                                                 && @Model[row].OldStatus!="REJECTED")
                                            {
                                                <div class="row m-1 border rounded-top mt-4 p-3">
                                                    <div class="col-md-3 col-lg-3 col-sm-3 col-3  mb-3">
                                                        <label for="Status" class="form-label">Status</label>
                                                        <select class="form-control" id="Status" asp-for="@Model[row].NewStatus" onchange="clearstatusvalidation()" onclick="clearstatusvalidation()">
                                                            <option value="Null">Please Select Status</option>
                                                            <option value="CANCELLED">CANCELLED</option>
                                                        </select>
                                                        <span id="validatestatus" class="text-danger"></span>
                                                    </div>
                                                    <div class="col-md-3 col-lg-3 col-sm-3 col-3  mb-3">
                                                        <label for="Remarks" class="form-label">Remarks</label>
                                                        <textarea class="form-control" asp-for="@Model[row].NewRemarks" id="Remarks" onkeypress="clearremarksvalidation()" onclick="clearremarksvalidation()"></textarea>
                                                        <span id="validateremarks" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        @if(@Model[row].OldStatus!="CANCELLED" && @Model[row].OldStatus!="VISITOR LEFT THE INSTITUTE"
                                                 && @Model[row].OldStatus!="REJECTED")
                                        {
                                            <button type="submit" class="btn btn-primary px-5 mt-2 float-end" onclick="return validateForm()">Submit</button>
                                        }
                                    
                                        <a class="btn btn-primary px-5 mt-2 ml-4" href="@Url.Action("MyVisitorPassRequestWithoutFilter","User")">Go Back</a>
                                    }
                                    
                                </div>
                                <h5 class="text-center mt-4 text-primary">Visitor Pass Status</h5>
                                <div class="row m-1 border rounded-top mt-4 p-3">
                                    @foreach (var pass in Model)
                                    {
                                        <div class="row">
                                            <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                <label for="Status" class="form-label">Status</label>
                                                <input type="text" asp-for="@pass.OldStatus" class="form-control" readonly>
                                            </div>
                                            <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                <label for="StaffNumber" class="form-label">Staff Number</label>
                                                <input type="text" asp-for="@pass.ActionTakenByStaffNumber" class="form-control" readonly>
                                            </div>
                                            <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                <label for="FirstName" class="form-label">Name</label>
                                                <input type="text" asp-for="@pass.ActionTakenByName" class="form-control" readonly>
                                            </div>
                                            <div class="col-xl-2 col-lg-3 col-md-6 mb-3">
                                                <label for="Designation" class="form-label">Designation</label>
                                                <input type="text" asp-for="@pass.ActionTakenByDesignation" class="form-control" readonly>
                                            </div>
                                            <div class="col-xl-3 col-lg-5 col-md-6 mb-3">
                                                <label for="Date" class="form-label">Date</label>
                                                <input type="text" asp-for="@pass.DateTime" class="form-control" readonly>
                                            </div>
                                            <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                                <label for="Remarks" class="form-label">Remarks</label>
                                                <textarea class="form-control" asp-for="@pass.OldRemarks" readonly></textarea>
                                            </div>
                                        </div>
                                        <hr />
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/user/view-my-visitor-pass-request.js"></script>