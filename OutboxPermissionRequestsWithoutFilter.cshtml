@using Digitalization.Models.UserModel
@model List<PermissionSlipModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">User</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("PermissionSlip","User")" style="text-decoration: none">PermissionSlip</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("OutboxPermissionRequestsWithoutFilter","User")" style="text-decoration: none">OutboxPermissionRequests</a></li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Outbox Permission Requests</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">
                                    <a class="btn btn-primary text-right mt-3" href="@Url.Action("OutboxPermissionRequests","User")">Filter Rows</a>
                                </div>
                            </div>
                            <hr>
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <table class="table table-bordered text-center" id="DataTable">
                                        <thead class="p-3">
                                            <tr>
                                                <th scope="col">Sl. No.</th>
                                                <th scope="col">Permission ID</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Permission Type</th>
                                                <th scope="col">Date</th>
                                                <th scope="col">Permission From</th>
                                                <th scope="col">Permission To</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Count() > 0)
                                            {
                                                @foreach (var permission in Model)
                                                {
                                                    <tr>
                                                        <td> @( ((Int32) 1) + @Model.IndexOf(permission) ) </td>
                                                        <td scope="row">@permission.PermissionID</td>
                                                        <td>@permission.StaffName</td>
                                                        @if(@permission.PermissionType == "OD")
                                                        {
                                                            <td>OD</td>
                                                        }
                                                        else if(@permission.PermissionType == "AL")
                                                        {
                                                            <td>Attended Late</td>
                                                        }
                                                        else if(@permission.PermissionType == "GE")
                                                        {
                                                            <td>Go Early</td>
                                                        }
                                                        <td>@permission.AlternateDate</td>
                                                        <td>@permission.AlternateFromTime</td>
                                                        <td>@permission.AlternateToTime</td>
                                                        <td>
                                                            <a class="btn btn-info text-white">@permission.OldStatus</a>
                                                        </td>
                                                        <td>
                                                            <a href="@Url.Action("ViewOutboxPermissionRequest","User",new { PermissionID = permission.PermissionID})" class="btn btn-primary">View</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">    
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>