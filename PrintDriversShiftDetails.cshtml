@using Digitalization.Models.CommonModel
@model List<DriversModel>

@*@if(ViewBag.IsFiltered==false)
{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}*@

<link rel="stylesheet" href="~/assets/css/admin/common.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->


<div class="mt-5">
    <div class="">
        <div class="">
            <div class="mx-5 mt-5">
                <br><br>
                <div class="main py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index","User")" style="text-decoration: none">Admin</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">PrintDriverShiftDetails</li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">
                                    <!-- @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@ -->
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Driver Shift Details</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">
                                    <a class="btn btn-primary px-4 py-2 text-white" onclick="window.print()">Print</a>
                                </div>
                            </div>
                            <hr>
                            <div>
                                <div class="tab-content">
                                    <div class="DriverTab" id="drivers">
                                        <h4 class="text-center text-primary">Shift Details</h4>
                                        <div class="row m-1 rounded-top p-3">
                                            <table class="table-bordered text-center">
                                                <tr class="py-3">
                                                    <th scope="col" class="text-black">Type of Shift</th>
                                                    <th scope="col" class="text-black">Abbreviation</th>
                                                    <th scope="col" class="text-black">Working hours</th>
                                                    <th scope="col" class="text-black">Lunch hours</th>
                                                </tr>
                                                @for (var row = 0; row < Model.Count(); row++)
                                                {
                                                    foreach(var drivershift in Model[row].DriversShift)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @if(@drivershift.ShiftType == "SH1")
                                                                {
                                                                    <p>Shift 1</p>
                                                                }
                                                                else if(@drivershift.ShiftType == "GSH")
                                                                {
                                                                    <p>General Shift</p>
                                                                }
                                                                else if(@drivershift.ShiftType == "SH2")
                                                                {
                                                                    <p>Shift 2</p>
                                                                }
                                                            </td>
                                                            <td>@drivershift.ShiftType</td>
                                                            <td>@drivershift.WorkingHours</td>
                                                            <td>@drivershift.LunchHours</td>
                                                        </tr>
                                                    }
                                                    break;
                                                }
                                            </table>
                                        </div>
                                        <h4 class="text-center text-primary">Assigned Shifts</h4>
                                        <div class="p-3 mx-3">
                                            <table class="table table-bordered text-center" id="DataTable">
                                                <thead class="p-3">
                                                    <tr>
                                                        <th scope="col" class="text-black">Staff Number</th>
                                                        <th scope="col" class="text-black">Name</th>
                                                        <th scope="col" class="text-black">From Date</th>
                                                        <th scope="col" class="text-black">To Date</th>
                                                        <th scope="col" class="text-black">Assigned Shift</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.Count() > 0)
                                                    {
                                                        @for (var row = 0; row < Model.Count(); row++)
                                                        {
                                                            <tr>
                                                                <td scope="row">@Model[row].StaffNumber</td>
                                                                <td>@Model[row].Name</td>
                                                                <td>@Model[row].AlternateFromDate</td>
                                                                <td>@Model[row].AlternateToDate</td>
                                                                <td>@Model[row].AssignedShift</td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/admin/drivers-shift-assign.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#DataTable').DataTable();
    });
</script>