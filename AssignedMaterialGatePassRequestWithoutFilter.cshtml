@using Digitalization.Models.UserModel
@model List<MaterialGatePassModel>

@{
    Layout = "~/Views/Shared/_LayoutWithNav.cshtml";
}

<link rel="stylesheet" href="~/assets/css/user/common-without-hover.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.12/css/jquery.dataTables.min.css" />
<script src="//cdn.datatables.net/1.10.12/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<!-- #region datatables files -->
<link rel="stylesheet" type="text/css" href="./assets/DataTables-1.11.5/css/dataTables.dataTables.min.css" />
<script src="./assets/DataTables-1.11.5/js/jquery.dataTables.min.js"></script>
<!-- #endregion -->

<div class="mt-5 ms-5">
    <div class="ms-5">
        <div class="ms-5">
            <div class="mx-5 mt-5 ms-5">
                <br><br>
                <div class="main ms-5 py-4 pb-0">
                    <div class="bs-example ms-5">
                        <div class="bs-example">
                            <nav aria-label="breadcrumb" class="pl-3">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Home","User")" style="text-decoration: none">User</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("MaterialGatePass","User")" style="text-decoration: none">MaterialGatePass</a></li>
                                    <li class="breadcrumb-item"><a href="@Url.Action("AssignedMaterialGatePassRequestWithoutFilter","User")" style="text-decoration: none">AssignedMaterialGatePassRequest</a></li>
                                </ol>
                            </nav>
                            <div class="row">
                                <div class="col-3">

                                    <!-- @*<h5 class="ml-5 mt-2 text-success">@ViewBag.SuccessMessage</h5>*@ -->
                                </div>
                                <div class="col-5">
                                    <h2 class="text-center">Material Gate Pass Requests</h2>
                                    <h4 class="text-center text-success">@ViewBag.SuccessMessage</h4>
                                    <h5 class="text-center text-danger">@ViewBag.ExceptionError</h5>
                                    <h5 id="ErrorMessage" class="text-center text-danger">@ViewBag.Error</h5>
                                    @*<h5 class="text-center text-success">@ViewBag.SuccessMessage</h5>*@
                                </div>
                                <div class="col-2"></div>
                                <div class="col-2">
                                    <a class="btn btn-primary text-right mt-3" href="@Url.Action("AssignedMaterialGatePassRequest","User")">Filter Rows</a>
                                </div>
                            </div>
                            <hr>
                            <div class="tab-content">
                                <div class="" id="userdetails">
                                    <table class="table table-bordered text-center" id="DataTable">
                                        <thead class="p-3">
                                            <tr>
                                                <th scope="col">Sl. No.</th>
                                                <th scope="col">GatePass ID</th>
                                                <th scope="col">Staff Number</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Return Type</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Count() > 0)
                                            {
                                                @foreach (var request in Model)
                                                {
                                            <tr>
                                                <td> @( ((Int32) 1) + @Model.IndexOf(request) ) </td>
                                                <td scope="row">@request.GatePassID</td>
                                                <td>@request.PreparedByStaffNumber</td>
                                                <td>@request.PreparedByFirstName</td>
                                                <td>@request.PreparedByDesignation</td>
                                                @if (@request.ReturnType == 1)
                                                {
                                                    <td>
                                                        <a class="btn btn-primary text-light">RETURNABLE</a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <a class="btn btn-info text-light">NON RETURNABLE</a>
                                                    </td>
                                                }
                                                <td>
                                                    @if (@request.OldStatus == "PREPARED" || @request.OldStatus == "CHECKED & ALLOWED")
                                                    {
                                                        <a class="btn btn-warning">@request.OldStatus</a>
                                                    }
                                                    else if (@request.OldStatus == "CHECKED" || @request.OldStatus == "PERMITTED")
                                                    {
                                                        <a class="btn btn-success text-light">@request.OldStatus</a>
                                                    }
                                                    else if (@request.OldStatus == "CANCELLED" || @request.OldStatus == "REJECTED")
                                                    {
                                                        <a class="btn btn-danger text-light">@request.OldStatus</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="btn btn-primary text-light">@request.OldStatus</a>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("ViewAssignedMaterialGatePassRequest","User",new { GatePassID = request.GatePassID})" class="btn btn-primary">View</a>
                                                </td>
                                            </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/assets/js/user/my-material-gate-pass-request.js"></script>